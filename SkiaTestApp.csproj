<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 禁止代码裁剪，确保 Linux FrameBuffer 运行时反射正常 -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Uno 核心与 Linux FrameBuffer 宿主 -->
    <PackageReference Include="Uno.WinUI" Version="6.6.184" />
    <PackageReference Include="Uno.WinUI.Skia.Linux.FrameBuffer" Version="6.6.184" />

    <!-- SkiaSharp 引擎及 WinUI/Uno 视图组件 -->
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.Views.Uno.WinUI" Version="4.151.1" />
  </ItemGroup>
</Project>
